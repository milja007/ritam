# Kopiraj u `.env` i upiši vrijednosti. Samo javne vrijednosti (EXPO_PUBLIC_*)!
# LLM ključevi idu isključivo u Supabase → Edge Functions → Secrets.
EXPO_PUBLIC_SUPABASE_URL=https://imsbokdyusrwyvyjvjfw.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
# Prijava e-mailom (magic link, korak 18) — iza feature flaga. 1 = uključeno (treba i URL + ključ gore).
EXPO_PUBLIC_FEATURE_AUTH=0
