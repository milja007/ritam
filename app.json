{
  "expo": {
    "name": "ritam",
    "slug": "ritam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ritam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.milja007.ritam"
    },
    "android": {
      "package": "com.milja007.ritam",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ritam uses the microphone only while you dictate a plan or a note.",
          "speechRecognitionPermission": "Ritam turns what you say into text for your plans and notes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ritam reads your sleep, steps and active calories to fill in your morning check-in and trackers. It never writes to Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
